<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#000000">

    <!-- Tab strip: tab buttons are added in code; +B / +T open tabs, long-press closes one -->
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#222222" android:scrollbars="none">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <LinearLayout android:id="@+id/tabs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"/>
            <Button android:id="@+id/tabSettings" style="?android:attr/borderlessButtonStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+" android:textSize="20sp" android:textColor="#7fd1ff"/>
        </LinearLayout>
    </HorizontalScrollView>

    <FrameLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="match_parent">

    <!-- Terminal: one view, sessions switched per tab -->
    <LinearLayout android:id="@+id/terminal" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
        <com.termux.view.TerminalView android:id="@+id/term" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:focusable="true" android:focusableInTouchMode="true"/>
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#222222">
            <LinearLayout android:id="@+id/keys" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/kEsc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Esc"/>
                <Button android:id="@+id/kTab" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tab"/>
                <Button android:id="@+id/kCtrl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ctrl"/>
                <Button android:id="@+id/kText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="あ"/>
                <Button android:id="@+id/kUp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="↑"/>
                <Button android:id="@+id/kDown" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="↓"/>
                <Button android:id="@+id/kLeft" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="←"/>
                <Button android:id="@+id/kRight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="→"/>
                <Button android:id="@+id/kPgUp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PgUp"/>
                <Button android:id="@+id/kPgDn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PgDn"/>
                <Button android:id="@+id/kReconnect" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Reconnect"/>
                <Button android:id="@+id/kClose" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Close tab"/>
            </LinearLayout>
        </HorizontalScrollView>
        <!-- Text input row: type with any IME (e.g. Japanese) here, then send it to the terminal -->
        <LinearLayout android:id="@+id/termInputRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="#222222" android:visibility="gone">
            <EditText android:id="@+id/termInput" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:inputType="text|textMultiLine|textNoSuggestions" android:imeOptions="actionSend|flagNoEnterAction" android:maxLines="3"
                android:hint="type here, Enter sends it as a line" android:textColor="#ffffff" android:textColorHint="#888888" android:textSize="14sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- "+" screen: open tabs, settings -->
    <ScrollView android:id="@+id/settings" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Web" android:textColor="#7fd1ff" android:textSize="16sp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <EditText android:id="@+id/openUrl" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:inputType="textUri" android:imeOptions="actionGo" android:singleLine="true" android:hint="http://mypc/" android:textColor="#ffffff" android:textColorHint="#888888"/>
                <Button android:id="@+id/openUrlBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Open"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/urlHistory" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="mosh" android:textColor="#7fd1ff" android:textSize="16sp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <EditText android:id="@+id/openTarget" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:inputType="textNoSuggestions" android:imeOptions="actionGo" android:singleLine="true" android:hint="user@home" android:textColor="#ffffff" android:textColorHint="#888888"/>
                <Button android:id="@+id/openTargetBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Open"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/targetHistory" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Settings" android:textColor="#7fd1ff" android:textSize="16sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Link key (shared with the exporter)" android:textColor="#cccccc"/>
            <EditText android:id="@+id/prefKey" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:textColor="#ffffff"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rendezvous server (blank = relay.ikeji.ma:4433)" android:textColor="#cccccc"/>
            <EditText android:id="@+id/prefServer" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textUri" android:textColor="#ffffff"/>
            <Button android:id="@+id/save" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Save &amp; restart msnw"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="SSH key for the mosh login (add the public key to ~/.ssh/authorized_keys on the exporter host)" android:textColor="#cccccc"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/genKey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Generate / show key"/>
                <Button android:id="@+id/copyKey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Copy"/>
            </LinearLayout>
            <TextView android:id="@+id/pubKey" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#7fd1ff" android:typeface="monospace" android:textSize="11sp" android:textIsSelectable="true"/>
            <TextView android:id="@+id/log" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textColor="#9c9" android:typeface="monospace" android:textSize="11sp"/>
        </LinearLayout>
    </ScrollView>
    </FrameLayout>
</LinearLayout>
