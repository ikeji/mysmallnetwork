#!/bin/bash
# msnw-mosh: run mosh to a host published with msnw-exporter.
#
#   msnw-mosh [-p PORT] [-key LINKKEY] [user@]NAME
#
# The exporter must publish sshd as its default target and allow PORT
# (default 60001) for mosh, e.g.:  msnw-exporter -key K -n home -t 22 -t 60001
#
# Steps: start mosh-server over ssh (through msnw-client as ProxyCommand),
# forward local UDP PORT to the exporter's PORT, then run mosh-client against
# 127.0.0.1. Extra ssh options can be given via $MSNW_MOSH_SSH.
set -eu
PORT=60001
KEY=${MSNW_KEY:-}
while [ $# -gt 0 ]; do
	case $1 in
	-p) PORT=$2; shift 2 ;;
	-key) KEY=$2; shift 2 ;;
	-h|--help) sed -n '2,12p' "$0"; exit 0 ;;
	*) break ;;
	esac
done
[ $# -eq 1 ] || { echo "usage: msnw-mosh [-p PORT] [-key LINKKEY] [user@]NAME" >&2; exit 2; }
[ -n "$KEY" ] || { echo "msnw-mosh: link key required (-key or \$MSNW_KEY)" >&2; exit 2; }
DEST=$1
NAME=${DEST##*@}
export MSNW_KEY=$KEY

for c in ssh mosh-client msnw-client; do
	command -v $c >/dev/null || { echo "msnw-mosh: $c not found" >&2; exit 1; }
done

# 1. bootstrap mosh-server through ssh; it listens on loopback only.
line=$(ssh -o ProxyCommand="msnw-client -n $NAME" ${MSNW_MOSH_SSH:-} "$DEST" -- \
	mosh-server new -i 127.0.0.1 -p "$PORT" -c 256 -l "LANG=${LANG:-en_US.UTF-8}" | grep '^MOSH CONNECT ')
set -- $line
[ "${1:-}" = MOSH ] || { echo "msnw-mosh: mosh-server did not start" >&2; exit 1; }
SPORT=$3 MKEY=$4

# 2. forward local UDP to the exporter's port.
msnw-client -n "$NAME:$SPORT" -l "udp:$SPORT" >/dev/null 2>&1 &
FWD=$!
trap 'kill $FWD 2>/dev/null' EXIT
sleep 0.5

# 3. run mosh against the local forwarder.
MOSH_KEY=$MKEY exec mosh-client 127.0.0.1 "$SPORT"
